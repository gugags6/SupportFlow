// SupportFlow - Prisma schema (initial release: Ticket Management)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Ticket {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable identifier (TCK-000001). Generated by the database from a
  /// PostgreSQL sequence (see generate_ticket_number() in the init migration),
  /// which is concurrency-safe. The UNIQUE constraint also provides its index.
  ticketNumber String         @unique @default(dbgenerated("generate_ticket_number()")) @map("ticket_number") @db.VarChar(20)
  title        String         @db.VarChar(200)
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("tickets")
}
