# ------------------------------------------------------------------
# SupportFlow - example environment (FICTIONAL DEVELOPMENT VALUES ONLY)
# Copy to .env and adjust. Never commit real credentials.
# ------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL container settings (used by docker-compose.yml)
POSTGRES_USER=exemplo_user
POSTGRES_PASSWORD=exemplo_password_dev
POSTGRES_DB=supportflow
# Host port mapped to the PostgreSQL container (for host-side tooling and tests)
POSTGRES_HOST_PORT=5436

# Host port mapped to the API container
API_HOST_PORT=3005

# Run the idempotent seed automatically when the API container starts
SEED_DATABASE=true

# Connection string used by host-side tooling (Prisma CLI, local `npm run start:dev`).
# Inside Docker Compose this is overridden to use the `postgres` service hostname.
DATABASE_URL=postgresql://exemplo_user:exemplo_password_dev@localhost:5436/supportflow?schema=public

# Separate database used by the e2e test suite (created automatically by docker/postgres/init).
TEST_DATABASE_URL=postgresql://exemplo_user:exemplo_password_dev@localhost:5436/supportflow_test?schema=public
